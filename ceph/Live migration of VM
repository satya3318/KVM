2. Test Ceph Connectivity
[root@kvm-node2 ~]# rbd ls vm-pool
vm101-disk

[root@kvm-node2 ~]# rbd -p vm-pool ls --id libvirt
vm101-disk

3. Create disk mapping 
[root@kvm-node2 ~]# rbd map vm-pool/vm101-disk --id libvirt
/dev/rbd0

4. root@kvm-node2 ~]# rbd showmapped
id  pool     namespace  image       snap  device   
0   vm-pool             vm101-disk  -     /dev/rbd0

5. Migrate VM 
  
root@kvm-node1 ceph]# virsh migrate   --live   --persistent   --undefinesource   vm101 qemu+ssh://root@kvm-node2/system

[root@kvm-node1 ceph]# 
